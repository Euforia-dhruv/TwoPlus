# Expo / React Native. Only source belongs in git: the native projects are
# generated by `npx expo prebuild`, and the dependency tree and caches are
# rebuilt from package-lock.json.
node_modules/
.expo/
dist/
web-build/

# Generated by expo prebuild. Regenerate rather than commit: they contain
# machine-specific Gradle and Xcode state.
android/
ios/

# Local env and export artifacts
.env
.env.*
*.jks
*.keystore
*.apk
*.aab
