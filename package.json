{
  "name": "gymos",
  "productName": "TwoPlus",
  "description": "Gym management for independent gyms: members, memberships, payments, attendance and payroll in one workspace.",
  "author": "TwoPlus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "npm run build && npm run lint",
    "test": "playwright test",
    "test:gate": "npm run check && npm run test",
    "desktop": "npm run build && electron .",
    "desktop:smoke": "npm run build && electron . --smoke-check",
    "desktop:icon": "node scripts/make-icon.mjs",
    "desktop:package": "npm run build && npm run desktop:icon && electron-packager . TwoPlus --platform=win32 --arch=x64 --out=release --overwrite --asar --icon=build/icon.ico --app-version=1.0.0 --win32metadata.CompanyName=TwoPlus --appCopyright=\"Copyright (C) 2026 TwoPlus\" --ignore=\"^/(?!(dist|electron)(/|$)|package\\.json$)\""
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "@tabler/icons-react": "^3.50.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
