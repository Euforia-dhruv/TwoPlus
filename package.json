{
  "name": "gymos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "npm run build && npm run lint",
    "test": "playwright test",
    "test:gate": "npm run check && npm run test",
    "audit:themes": "node scripts/_themes.mjs",
    "audit:contrast": "node scripts/_contrast.mjs",
    "audit:auth": "node scripts/_auth-theme.mjs && node scripts/_auth-contrast.mjs",
    "audit:studio": "node scripts/_studio.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
