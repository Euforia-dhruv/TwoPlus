# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Netlify folder
.netlify

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Android signing. The keystore itself lives outside the repo; this file holds
# its password, so it must never be committed.
android/keystore.properties
*.jks
*.keystore

# Supabase CLI local state
supabase/.temp
.vercel

# One-off browser probes. Keep them out of the repo: they were written to answer
# a single audit question and are not maintained. scripts/shots.mjs is the
# supported capture tool, and scripts/_a11y-probe.mjs is cited by docs/AUDIT.md.
scripts/_*.mjs
!scripts/_a11y-probe.mjs

# Playwright screenshots and reports
screenshots
# Design review captures (re-generate with scripts/shots.mjs)
.taste-skill
test-results
playwright-report
# The suite's saved login. Never commit a session token.
tests/.auth
# Desktop build output (npm run desktop:package) and its generated icon.
release
build
# Generated by scripts/checksums.mjs; regenerated at release time.
SHA256SUMS

# Agent skill scratch: installed per-machine, not part of the app.
.agents/skills/
